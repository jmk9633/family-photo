{
  "expo": {
    "name": "가족 사진",
    "slug": "family-photo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "familyphoto",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.jmk9633.familyphoto",
      "usesAppleSignIn": true,
      "appleTeamId": "2LSRUZU8A8",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.jmk9633.familyphoto"
        ]
      }
    },
    "android": {
      "package": "com.jmk9633.familyphoto",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "가족에게 보낼 사진을 고르려면 사진 보관함 접근을 허용해 주세요."
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "가족에게 보낼 사진과 영상 한마디를 찍으려면 카메라를 허용해 주세요.",
          "microphonePermission": "영상 한마디에 목소리를 담으려면 마이크를 허용해 주세요.",
          "recordAudioAndroid": true
        }
      ],
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "FamilyPhotoLarge",
              "label": "가족 사진 크게",
              "description": "가족이 보낸 최근 사진을 홈 화면에서 바로 봐요.",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FamilyPhotoMedium",
              "label": "가족 사진 작게",
              "description": "가족이 보낸 최근 사진을 홈 화면에서 바로 봐요.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4507bd27-7128-425d-a528-0b08f9d31dfa"
      }
    },
    "owner": "jmk9633"
  }
}
