{
  "expo": {
    "name": "가족 사진",
    "slug": "family-photo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "familyphoto",
    "userInterfaceStyle": "light",
    "ios": {
      "usesAppleSignIn": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
